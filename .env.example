# ==============================================================================
# ExaminAI Development Environment Variables
# Copy this file to '.env' and adjust the variables for your local development.
# ==============================================================================

# Global Settings
NODE_ENV=development
APP_NAME="ExaminAI Platform"
DOMAIN=localhost

# --- DATABASE SETUP (Postgres with pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_NAME=examinai_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# --- REDIS / CACHE / QUEUE SETUP ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- S3 COMPATIBLE STORAGE (MinIO) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=exam-files
MINIO_USE_SSL=false

# --- SERVICES ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
