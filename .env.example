# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on your server
# ============================================

NODE_ENV=production

# Database Credentials for Docker Compose
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here
DB_DATABASE=enterprise_exam_db

# Next.js App Database URL (Internal Docker Container Network)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres-primary:5432/${DB_DATABASE}

# NextAuth Domain & Security
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your_super_secret_32_character_nextauth_key

# Redis Cache & Queue
REDIS_URL=redis://redis:6379

# Object Storage (MinIO / S3)
MINIO_USER=minio_admin
MINIO_PASSWORD=minio_secure_password_here

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
