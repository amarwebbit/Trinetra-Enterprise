# ============================================
# CRITICAL - Required for application to run
# ============================================

# Database (use PgBouncer for pooling)
DATABASE_URL=postgresql://examin_admin:secure_password@pgbouncer:6432/exam_engine?schema=public&pgbouncer=true
DATABASE_URL_POOLED=postgresql://examin_admin:secure_password@pgbouncer:6432/exam_engine?schema=public&pgbouncer=true

# NextAuth authentication
NEXTAUTH_SECRET=your-super-secret-key-at-least-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# ============================================
# RECOMMENDED - For production performance
# ============================================

# Redis (for caching) - either REDIS_URL or Upstash
REDIS_URL=redis://redis:6379

# ============================================
# OPTIONAL - For specific features
# ============================================

# Email notifications (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@examin.ai

# SMS/WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+1234567890

# AI (OpenAI)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Code Execution (Judge0)
JUDGE0_API_URL=http://judge0:2358
JUDGE0_API_KEY=your-judge0-api-key

# File Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=exam-files

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/123456

# Monitoring
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
